body {
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.app {
  width: 100%;
  max-width: 430px;
  min-height: 100%;
  padding:
    max(25px, env(safe-area-inset-top))
    20px
    max(25px, env(safe-area-inset-bottom))
    20px;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
