<body>

<div class="app">

  <div class="title">
    Taco Bell Finder
  </div>

  <div
    class="finder"
    id="finder"
    onclick="openMaps()"
  >

    <div class="inner-ring"></div>

    <div class="direction north">
      N
    </div>

    <div class="direction east">
      E
    </div>

    <div class="direction south">
      S
    </div>

    <div class="direction west">
      W
    </div>

    <div class="logo">
      TB
    </div>

  </div>

  <div
    class="distance"
    id="distance"
  >
    -- mi
  </div>

  <div
    class="location"
    id="location"
  >
    Finding Taco Bell...
  </div>

  <div
    class="status"
    id="status"
  >
    Getting your location
  </div>

  <button
    class="refresh"
    onclick="findNearestTacoBell(event)"
  >
    Refresh
  </button>

</div>

<script>

/* =====================================================
   SETTINGS
===================================================== */

const SEARCH_RADIUS_MILES = 30;

const SEARCH_RADIUS_METERS =
  SEARCH_RADIUS_MILES * 1609.344;


/* =====================================================
   CURRENT TACO BELL
===================================================== */

let currentTacoBell = null;


/* =====================================================
   ELEMENTS
===================================================== */

const distanceElement =
  document.getElementById("distance");

const locationElement =
  document.getElementById("location");

const statusElement =
  document.getElementById("status");

const finderElement =
  document.getElementById("finder");


/* =====================================================
   DISTANCE CALCULATION
   Haversine formula
===================================================== */

function getDistance(
  lat1,
  lon1,
  lat2,
  lon2
) {

  const earthRadius =
    3958.7613;

  const latitudeDifference =
    toRadians(lat2 - lat1);

  const longitudeDifference =
    toRadians(lon2 - lon1);

  const a =
    Math.sin(latitudeDifference / 2) ** 2 +

    Math.cos(toRadians(lat1)) *
    Math.cos(toRadians(lat2)) *
    Math.sin(longitudeDifference / 2) ** 2;

  const c =
    2 *
    Math.atan2(
      Math.sqrt(a),
      Math.sqrt(1 - a)
    );

  return earthRadius * c;
}


function toRadians(degrees) {

  return degrees *
    Math.PI /
    180;
}


/* =====================================================
   GET TACO BELLS FROM OPENSTREETMAP
===================================================== */

async function searchTacoBells(
  latitude,
  longitude
) {

  const query = `

    [out:json][timeout:25];

    (
      node
        ["amenity"="fast_food"]
        ["brand"~"Taco Bell",i]
        (around:${SEARCH_RADIUS_METERS},
        ${latitude},
        ${longitude});

      node
        ["name"~"Taco Bell",i]
        (around:${SEARCH_RADIUS_METERS},
        ${latitude},
        ${longitude});

      way
        ["amenity"="fast_food"]
        ["brand"~"Taco Bell",i]
        (around:${SEARCH_RADIUS_METERS},
        ${latitude},
        ${longitude});

      way
        ["name"~"Taco Bell",i]
        (around:${SEARCH_RADIUS_METERS},
        ${latitude},
        ${longitude});
    );

    out center tags;

  `;

  const response =
    await fetch(
      "https://overpass-api.de/api/interpreter",
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/x-www-form-urlencoded"
        },

        body:
          "data=" +
          encodeURIComponent(query)
      }
    );

  if (!response.ok) {

    throw new Error(
      "Taco Bell search failed"
    );
  }

  return await response.json();
}


/* =====================================================
   FIND CLOSEST
===================================================== */

async function findNearestTacoBell(
  event
) {

  if (event) {
    event.stopPropagation();
  }

  statusElement.textContent =
    "Getting your location...";

  locationElement.textContent =
    "Searching nearby Taco Bells...";

  distanceElement.textContent =
    "-- mi";

  if (!navigator.geolocation) {

    showError(
      "Location isn't supported"
    );

    return;
  }

  navigator.geolocation.getCurrentPosition(

    async function(position) {

      const userLatitude =
        position.coords.latitude;

      const userLongitude =
        position.coords.longitude;

      statusElement.textContent =
        "Searching Taco Bells...";

      try {

        const results =
          await searchTacoBells(
            userLatitude,
            userLongitude
          );

        let nearest = null;

        let nearestDistance =
          Infinity;


        /* ---------------------------------------------
           Check every Taco Bell
        --------------------------------------------- */

        for (
          const place of results.elements
        ) {

          let tacoLatitude =
            place.lat ??
            place.center?.lat;

          let tacoLongitude =
            place.lon ??
            place.center?.lon;


          if (
            tacoLatitude === undefined ||
            tacoLongitude === undefined
          ) {

            continue;
          }


          const miles =
            getDistance(
              userLatitude,
              userLongitude,
              tacoLatitude,
              tacoLongitude
            );


          if (
            miles < nearestDistance
          ) {

            nearestDistance =
              miles;

            nearest = {

              latitude:
                tacoLatitude,

              longitude:
                tacoLongitude,

              distance:
                miles,

              name:
                place.tags?.name ||
                "Taco Bell"

            };

          }

        }


        /* ---------------------------------------------
           Nothing found
        --------------------------------------------- */

        if (!nearest) {

          showError(
            "No Taco Bell found within 30 miles"
          );

          return;
        }


        /* ---------------------------------------------
           Save nearest
        --------------------------------------------- */

        currentTacoBell =
          nearest;


        /* ---------------------------------------------
           Display
        --------------------------------------------- */

        distanceElement.textContent =
          nearest.distance.toFixed(1) +
          " mi";


        locationElement.textContent =
          nearest.name;


        statusElement.textContent =
          "Tap the dial for directions";


      }

      catch(error) {

        console.error(error);

        showError(
          "Taco Bell search failed"
        );

      }

    },


    function(error) {

      console.error(error);

      showError(
        "Allow location access to use this"
      );

    },


    {
      enableHighAccuracy: true,

      maximumAge: 120000,

      timeout: 20000
    }

  );

}


/* =====================================================
   OPEN GOOGLE MAPS
===================================================== */

function openMaps() {

  if (!currentTacoBell) {

    findNearestTacoBell();

    return;
  }


  const latitude =
    currentTacoBell.latitude;

  const longitude =
    currentTacoBell.longitude;


  const googleMapsURL =
    "https://www.google.com/maps/dir/?api=1" +
    "&destination=" +
    latitude +
    "," +
    longitude;


  window.location.href =
    googleMapsURL;
}


/* =====================================================
   ERROR
===================================================== */

function showError(message) {

  distanceElement.textContent =
    "-- mi";

  locationElement.textContent =
    message;

  statusElement.textContent =
    "Tap Refresh to try again";

  statusElement.classList.add(
    "error"
  );
}


/* =====================================================
   START
===================================================== */

findNearestTacoBell();


/* =====================================================
   AUTOMATIC UPDATE
   Every 2 minutes
===================================================== */

setInterval(
  findNearestTacoBell,
  120000
);

</script>

</body>
</html>
