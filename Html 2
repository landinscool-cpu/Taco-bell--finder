.north {
  top: 27px;
  left: 50%;
  transform: translateX(-50%);
}

.east {
  right: 27px;
  top: 50%;
  transform: translateY(-50%);
}

.south {
  bottom: 27px;
  left: 50%;
  transform: translateX(-50%);
}

