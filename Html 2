/* -------------------------
   TITLE
------------------------- */

.title {
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #E7C5FF;

  margin-bottom: 22px;
}

/* -------------------------
   MAIN DISPLAY
------------------------- */

.finder {
  width: min(82vw, 320px);
  aspect-ratio: 1;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      #160821 0%,
      #09040F 62%,
      #09040F 100%
    );

  border: 9px solid #491080;

  box-shadow:
    0 0 0 4px #8B20FF,
    0 0 25px rgba(139,32,255,.65),
    inset 0 0 25px rgba(139,32,255,.25);

  position: relative;

  cursor: pointer;

  transition:
    transform .15s ease,
    box-shadow .15s ease;
}

.finder:active {
  transform: scale(.97);

  box-shadow:
    0 0 0 4px #8B20FF,
    0 0 40px rgba(139,32,255,.9),
    inset 0 0 30px rgba(139,32,255,.35);
}

/* -------------------------
   OUTER TICKS
------------------------- */

.finder::before {

  content: "";

  position: absolute;

  inset: 15px;

  border-radius: 50%;

  background:
    repeating-conic-gradient(
      from 0deg,
      #8B20FF 0deg 1deg,
      transparent 1deg 11.25deg
    );

  mask:
    radial-gradient(
      transparent 0 87%,
      black 88% 100%
    );

